<body class="<%= controller_name %> <%= action_name %>">

  <div class="container-form">

    <h1 class = "request-title">申請画面</h1>

    <%= form_with model: @attendance_request, url: attendance_requests_path, method: :post do |f| %>

      <div class="form-group">
        <div class="form-workDate">
          <%= f.label :work_date, "勤務日" %>
          <%= f.date_field :work_date, required: true %>
        </div>

        <div class="form-startTime">
          <%= f.label :start_time, "出勤時刻" %>
          <%= f.time_field :start_time, required: true %>
        </div>

        <div class="form-endTime">
          <%= f.label :end_time, "退勤時刻" %>
          <%= f.time_field :end_time, required: true %>
        </div>

        <div class="form-breakMinutes">
          <%= f.label :break_minutes, "休憩時間（分）" %>
          <%= f.number_field :break_minutes, min: 0, required: true %>
        </div>

        <div class="form-note">
          <%= f.label :note, "備考" %>
          <%= f.text_area :note %>
        </div>

        <div class="form-actions">
          <%= f.submit "申請する", class: "btn btn-primary" %>
        </div>
      </div>

    <% end %>

  </div>
</body>